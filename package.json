{
  "name": "@jim-technologies/invariant-protocol",
  "version": "0.15.0",
  "private": true,
  "description": "Project gRPC services into MCP, CLI, HTTP/Connect, and gRPC interfaces from proto descriptors",
  "type": "module",
  "main": "./typescript/dist/index.js",
  "types": "./typescript/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./typescript/dist/index.d.ts",
      "import": "./typescript/dist/index.js"
    }
  },
  "files": [
    "typescript/dist",
    "README.md",
    "LICENSE",
    "VERSION"
  ],
  "scripts": {
    "build": "tsc -p typescript/tsconfig.json",
    "format": "biome format --write typescript",
    "format:check": "biome format typescript",
    "lint": "biome lint typescript",
    "test": "vitest run --root typescript",
    "test:coverage": "vitest run --root typescript --coverage",
    "typecheck": "tsc -p typescript/tsconfig.json --noEmit && tsc -p typescript/tsconfig.test.json",
    "prepare": "npm run build"
  },
  "keywords": [
    "grpc",
    "protobuf",
    "mcp",
    "connect"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jim-technologies/invariantprotocol.git"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "@bufbuild/protovalidate": "1.2.0",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.2",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/reflection": "^1.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@bufbuild/protoc-gen-es": "^2.13.0",
    "@grpc/proto-loader": "^0.8.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "^7.0.2",
    "vitest": "4.1.10"
  }
}
