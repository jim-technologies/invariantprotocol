#!/bin/sh
# public-surface-check - the canonical public-surface guard.
#
# One implementation, one filename, one invocation, in every public repository
# in this organisation. Run it as `scripts/public-surface-check` from the
# `validate` verb of the repository Makefile.
#
# WHAT IT SCANS
#   1. the content of every tracked file (working tree, binaries skipped)
#   2. every tracked file path
#   3. the commit messages a push would publish - by default the commits that
#      are not yet on the upstream main branch
#
# WHAT IT DENIES
#   private repository names, internal infrastructure names, first-party
#   codenames, cluster and infrastructure shapes, credential shapes, encrypted
#   secret stores, and private remotes. Every denied term is assembled from
#   fragments below, and so is every probe: this file is scanned by itself, so
#   a term spelled as one contiguous literal here would fail this guard. That
#   is deliberate. It keeps the deny list out of the reader's hands, and it
#   keeps the guard honest about scanning itself.
#
# HOW EXCEPTIONS ARE MADE
#   Never by editing this file. Each repository keeps its own
#   `.public-surface-allow`, one rule per line:
#
#       category | path-glob | reason | pattern
#
#   category    a deny category name (see --help) or `*` for every category
#   path-glob   `*` for everywhere, or a glob over the repository-relative
#               path; use `COMMIT` for commit-message exceptions
#   reason      free text, at least 8 characters - required, this is the
#               justification the next reviewer reads
#   pattern     POSIX extended regular expression. `|` is allowed here because
#               this is the last field. `%HH` is a hex escape (write `%25` for
#               a literal `%`) so a repository can name a term without
#               spelling it either.
#
#   A matching rule masks the text it matches before the deny patterns run, so
#   an exception excuses exactly the text it names and nothing else on the
#   line. A rule broad enough to disable a whole deny category is rejected.
#
#   A repository that must deny more than the fleet baseline keeps
#   `.public-surface-deny` in the same format; its `reason` is printed as the
#   remediation text when the rule fires.
#
# ENVIRONMENT
#   PUBLIC_SURFACE_FULL_HISTORY=1   scan every commit in the repository
#                                   (audit run) instead of the unpushed range
#   PUBLIC_SURFACE_COMMIT_RANGE=X   scan an explicit `git log` revision range
#   PUBLIC_SURFACE_SHOW_MATCH=1     print matched text in full; findings are
#                                   redacted by default so a public CI log
#                                   never republishes what the guard caught
#   PUBLIC_SURFACE_MAX_FINDINGS=N   findings printed before truncation (50)
#
# EXIT CODES
#   0 clean   1 findings   2 the guard could not run or is misconfigured
#
# Dependencies: POSIX sh, git, awk, tr. Nothing else, on purpose: these
# repositories are written in node, python, bash, go and rust, and no language
# runtime is common to all of them. git is already a hard requirement of this
# guard's own contract, and a POSIX shell and awk are present wherever git is.

set -eu
LC_ALL=C
export LC_ALL

usage() {
	cat <<'USAGE'
usage: scripts/public-surface-check [--full-history] [--help]

Scans tracked file content, tracked file paths, and the commit messages a push
would publish, for private names and other material that must not appear in a
public repository.

Deny categories:
  private-repo       private repository names, private hostnames, references
                     to organisation repositories that are not public
  internal-infra     internal infrastructure and datastore component names
  codename           first-party product codenames and product-qualified
                     internal service names
  cluster-shape      cluster DNS, kube context and namespace shapes, private
                     address ranges, mesh and non-public hostnames, private
                     container image paths
  credential-shape   key material, provider token prefixes, JWT-shaped
                     literals, high-entropy assignments to secret-like names
  secret-store       encrypted secret stores, key files, dotenv files, CI
                     secret references
  private-remote     ssh git remotes and private package registries

Exceptions live in .public-surface-allow (category | path-glob | reason |
pattern); extra repository-specific denials live in .public-surface-deny in the
same format. Both require a reason on every rule.
USAGE
}

while [ "$#" -gt 0 ]; do
	case "$1" in
	-h | --help)
		usage
		exit 0
		;;
	--full-history)
		PUBLIC_SURFACE_FULL_HISTORY=1
		export PUBLIC_SURFACE_FULL_HISTORY
		;;
	*)
		printf 'public-surface-check: unknown argument: %s\n' "$1" >&2
		usage >&2
		exit 2
		;;
	esac
	shift
done

for tool in git awk tr; do
	command -v "$tool" >/dev/null 2>&1 || {
		printf 'public-surface-check: %s is required\n' "$tool" >&2
		exit 2
	}
done

root=$(git rev-parse --show-toplevel 2>/dev/null) || {
	printf 'public-surface-check: not inside a git repository\n' >&2
	exit 2
}
cd "$root"

US=$(printf '\037')

# ---------------------------------------------------------------------------
# Fragments. Nothing below is a contiguous literal in this file.
# ---------------------------------------------------------------------------
mdl='med'"allion"  # first-party brand token
jtc='jim'"tech"    # organisation token
onl='onto'"logy"   # codename, lower case
onlc='Onto'"logy"  # codename, capitalised
cmp='com'"pass"    # codename

r_vault='git-'"vault"
r_orgrepo="${jtc}"'nologies'
r_scrape='xscr'"aper"
r_ida='i'"da"
r_field='fiel'"dx"
r_tick='tick'"tock"
r_auto='auto'"bots"
r_back='back'"hub"
r_ibfk='ibfk'"rich"
r_deep='ai-deep-'"research"
r_care='pj-senior-'"care-centre"
r_gha='gh'"actions"

i_otel="${mdl}"'-otel-agent'
i_nodeobs="${mdl}"'-node-observability'
i_store="${jtc}"'-store'
i_iac="${jtc}"'-iac'
i_backup="${jtc}"'-backups'
i_db="${mdl}"'db'
i_teleme='platform_'"telemetry"

k_ctl='kube'"ctl"
k_conf='kube'"config"
k_ns='kube'"ns"
k_ctx='kube'"ctx"
k_k3s='k'"3s"
k_k9s='k'"9s"
k_curctx='current-'"context"
k_box='t79'"10"
k_mesh='tail'"scale"
k_net='tail'"net"

s_sops='so'"ps"
s_agekey='age'"-key"
s_agesec='AGE-'"SECRET-KEY-1"
s_agerec='age'"1"
s_pem='-----'"BEGIN"
s_pem2='PRIVATE '"KEY-----"
s_ghsec='sec'"rets."
s_gcrypt='git-'"crypt"

n_artifactory='artif'"actory"
n_verdaccio='verda'"ccio"
n_ssh='ss'"h://"

# Boundaries. Lower-case pass (CI) and verbatim pass (CS).
b='(^|[^a-z0-9_])'
e='($|[^a-z0-9_])'
bc='(^|[^A-Za-z0-9_])'
ec='($|[^A-Za-z0-9_])'
hb='(^|[^a-z0-9_.-])'
he='($|[^a-z0-9_.-])'
nb='(^|[^0-9.])'
ne='($|[^0-9.])'

# ---------------------------------------------------------------------------
# Deny categories. `_CI` is matched against the lower-cased line, `_CS` against
# the line as written. `_PROBE` holds strings that MUST match: the guard
# refuses to run when a category has stopped matching its own probe. That is
# what stops a guard from being green because it checks nothing.
# ---------------------------------------------------------------------------
PSC_NCAT=7

PSC_C1_NAME='private-repo'
PSC_C1_CI="${b}(${mdl}-(cloud|iam|${onl}|storage|compute|os|connect|terminal|machine)|${r_vault}|${r_orgrepo}|${r_scrape}|${r_ida}|${r_field}|${r_tick}|${r_auto}|${r_back}|${r_ibfk}|${r_deep}|${r_care}|${r_gha})${e}"
PSC_C1_CI="${PSC_C1_CI}|${hb}[a-z0-9][a-z0-9-]*\\.${jtc}\\.(xyz|io|com|dev)${he}"
PSC_C1_CI="${PSC_C1_CI}|github\\.com[:/]jim-technologies/[a-z0-9._-]+"
PSC_C1_CI="${PSC_C1_CI}|\\.\\./(${mdl}-[a-z0-9-]+|${jtc}[a-z0-9-]*)"
PSC_C1_CS=''
PSC_C1_PROBE="clone ${mdl}-cloud today${US}vendored from ../${mdl}-iam${US}host www.${jtc}.xyz${US}repo git""hub.com/jim-technologies/not-public-yet${US}the ${r_ida} exporter${US}${r_care} rota${US}${r_vault} mirror"
PSC_C1_FIX='Name no private repository, no private host, and no organisation repository that is not public. Describe the capability instead, or add a justified rule to .public-surface-allow.'

PSC_C2_NAME='internal-infra'
PSC_C2_CI="${b}(${i_otel}|${i_nodeobs}|${i_store}|${i_iac}|${i_backup}|${i_db}|${i_teleme})${e}"
PSC_C2_CS=''
PSC_C2_PROBE="deployed ${i_otel} v2${US}rows land in ${i_db}${US}the ${i_teleme} table${US}${i_iac} module${US}${i_backup} retention"
PSC_C2_FIX='Internal infrastructure and datastore component names stay internal. Describe the dependency generically.'

PSC_C3_NAME='codename'
PSC_C3_CI="${b}${cmp}${e}"
PSC_C3_CI="${PSC_C3_CI}|${mdl}[ ._-](${onl}|connect|terminal|${cmp})"
PSC_C3_CI="${PSC_C3_CI}|${b}(${onl}|${cmp})[ -](service|api|backend|cluster|deployment|repo|repository|team)${e}"
PSC_C3_CI="${PSC_C3_CI}|${mdl}(${onl}|connect|terminal|${cmp})[a-z]*service"
PSC_C3_CI="${PSC_C3_CI}|(^|[^a-z0-9])(terminal|first[-_]party)[-_]${cmp}"
PSC_C3_CS="${bc}${onlc}${ec}"
PSC_C3_PROBE="the ${cmp} rollout${US}${mdl}.${onl}.v1${US}${mdl} Connect ingest${US}${onl} service owner${US}${onlc} objects and links${US}${mdl}TerminalService stub${US}profile terminal_${cmp}_read"
PSC_C3_FIX='First-party codenames and product-qualified internal service names must not appear on a public surface. A public package namespace this repository owns belongs in .public-surface-allow, with the reason that publishing it is why the repository exists.'

PSC_C4_NAME='cluster-shape'
# Cluster DNS carries two labels before the service suffix, so a single-label
# RPC path segment such as /x.svc/ is not a cluster hostname.
PSC_C4_CI="${b}[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*\\.svc(\\.cluster\\.local)?${he}"
PSC_C4_CI="${PSC_C4_CI}|cluster\\.local"
PSC_C4_CI="${PSC_C4_CI}|${b}(${k_ctl}|${k_conf}|${k_ns}|${k_ctx}|${k_k3s}|${k_k9s}|${k_curctx}|${k_box}|${k_mesh}|${k_net})${e}"
PSC_C4_CI="${PSC_C4_CI}|--context[= ][a-z0-9._-]+|--namespace[= ][a-z0-9-]+"
PSC_C4_CI="${PSC_C4_CI}|\\.ts\\.net"
PSC_C4_CI="${PSC_C4_CI}|ghcr\\.io/jim-technologies"
PSC_C4_CI="${PSC_C4_CI}|${nb}(10\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}|192\\.168\\.[0-9]{1,3}\\.[0-9]{1,3}|172\\.(1[6-9]|2[0-9]|3[01])\\.[0-9]{1,3}\\.[0-9]{1,3}|100\\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\\.[0-9]{1,3}\\.[0-9]{1,3})${ne}"
# These patterns are regex text passed to awk through the environment; the
# shell never re-parses them as words.
# shellcheck disable=SC2089
PSC_C4_CI="${PSC_C4_CI}|^[ 	]*namespace\\??:[ 	]*[\"']?[a-z0-9][a-z0-9-]*[\"']?[ 	]*\$"
# Lower-case only, so that a capitalised third-party identifier such as the
# gRPC status code codes.Internal is not a hostname. A multi-label name only
# counts inside a URL, after an @, or with a port, so that a dotted module
# path such as google.protobuf.internal is not a hostname either.
PSC_C4_CS="(://|@)[a-z0-9][a-z0-9.-]*\\.(internal|corp|intranet|lan)${he}"
PSC_C4_CS="${PSC_C4_CS}|[a-z0-9][a-z0-9.-]*\\.(internal|corp|intranet|lan):[0-9]{1,5}${he}"
PSC_C4_CS="${PSC_C4_CS}|${hb}[a-z0-9][a-z0-9-]*\\.(internal|corp|intranet|lan)${he}"
PSC_C4_PROBE="api.${mdl}.svc.clus""ter.local${US}${k_ctl} get pods${US}--con""text prod-a1${US}reach 10.""7.0.14 now${US}peer 100.""83.4.9 is up${US}host ${k_box} online${US}image ghcr"".io/jim-technologies/private-svc${US}db.${jtc}-1.inter""nal:5432${US}    namespace: platform-a1"
PSC_C4_FIX='Cluster DNS, kube context and namespace shapes, private address ranges, mesh and non-public hostnames, and private container image paths describe infrastructure that is not public. Use the documentation ranges (192.0.2.0/24) and example hostnames instead.'

PSC_C5_NAME='credential-shape'
PSC_C5_CI=''
PSC_C5_CS="${s_pem} [A-Z0-9 ]*${s_pem2}"
PSC_C5_CS="${PSC_C5_CS}|${bc}gh[pousr]_[A-Za-z0-9]{36}${ec}"
PSC_C5_CS="${PSC_C5_CS}|${bc}github_pat_[A-Za-z0-9_]{22,}"
PSC_C5_CS="${PSC_C5_CS}|${bc}xox[abprs]-[A-Za-z0-9-]{10,}"
PSC_C5_CS="${PSC_C5_CS}|${bc}sk-[A-Za-z0-9_-]{16,}"
PSC_C5_CS="${PSC_C5_CS}|${bc}AKIA[0-9A-Z]{16}${ec}"
PSC_C5_CS="${PSC_C5_CS}|${bc}AIza[A-Za-z0-9_-]{35}"
PSC_C5_CS="${PSC_C5_CS}|${bc}eyJ[A-Za-z0-9_=-]{10,}\\.[A-Za-z0-9_=-]{10,}\\.[A-Za-z0-9_=-]{10,}"
PSC_C5_CS="${PSC_C5_CS}|${s_agesec}[0-9A-Z]{20,}"
PSC_C5_CS="${PSC_C5_CS}|${bc}${s_agerec}[0-9a-z]{50,}"
PSC_C5_PROBE="${s_pem} RSA ${s_pem2}${US}token gh""p_0123456789abcdefghijklmnopqrstuvwxyz${US}slack xox""b-1234567890-abcdefghij${US}aws AKI""AABCDEFGHIJKLMNOP${US}google AIz""aSyA12345678901234567890123456789012${US}bearer ey""Jhbgcioijiuzi1nij9.ey""Jzdwiioiixmjm0nty3odkwin0.dozjgnryp4j3jvmnhl0w5n"
PSC_C5_FIX='Key material and provider tokens must never be committed, not even expired or example ones. Remove it, rotate the credential, and use an obviously fake placeholder in documentation.'

PSC_C6_NAME='secret-store'
PSC_C6_CI="(^|/)\\.${s_sops}\\.ya?ml${he}"
PSC_C6_CI="${PSC_C6_CI}|(^|/)secrets?/"
# Key-file extensions are anchored to a whole filename, so a tracked key file
# is caught while a passing mention inside a line of code or prose is not.
PSC_C6_CI="${PSC_C6_CI}|^[a-z0-9._/-]+\\.(age|gpg|kdbx|jks|keystore|p8|pfx|pem|asc)\$"
PSC_C6_CI="${PSC_C6_CI}|${b}${s_agekey}|(^|/)${s_agekey}"
PSC_C6_CI="${PSC_C6_CI}|(^|/)\\.env(\\.|${he})"
PSC_C6_CI="${PSC_C6_CI}|${b}${s_sops}${e}"
PSC_C6_CI="${PSC_C6_CI}|\\.${s_gcrypt}|secrets\\.(enc|ya?ml\\.enc)"
PSC_C6_CI="${PSC_C6_CI}|\\\$\\{\\{[ 	]*secrets\\."
PSC_C6_CS=''
PSC_C6_PROBE=".${s_sops}.yaml${US}deploy/secr""ets/db.yaml${US}keys/${s_agekey}.txt${US}config/.e""nv${US}decrypt with ${s_sops} first${US}\${{ ${s_ghsec}DEPLOY_TOKEN }}${US}vault.g""pg"
PSC_C6_FIX='These repositories hold no secrets, encrypted or otherwise, and their CI runs the gate and nothing that needs a secret. Remove the store, the key file, or the CI secret reference.'

PSC_C7_NAME='private-remote'
PSC_C7_CI="${b}git@[a-z0-9.-]+:"
PSC_C7_CI="${PSC_C7_CI}|(^|[^a-z0-9_+])(git\\+)?${n_ssh}"
PSC_C7_CI="${PSC_C7_CI}|npm\\.pkg\\.github\\.com|\\.jfrog\\.io|${b}${n_artifactory}|${b}${n_verdaccio}|nexus[.-]?(repo|registry)"
PSC_C7_CS=''
PSC_C7_PROBE="git@""github.com:someone/thing.git${US}clone ${n_ssh}host/repo.git${US}registry npm.pkg"".github.com${US}proxy repo.jf""rog.io${US}mirrored through an ${n_artifactory} proxy"
PSC_C7_FIX='A public repository is cloned and installed over public HTTPS only. Remove the ssh remote or the private registry reference.'

PSC_ENTROPY_CAT='credential-shape'
# shellcheck disable=SC2089
PSC_ENTROPY_RE="${b}(pass(word|wd)?|secret|token|api[_-]?key|access[_-]?key|auth[_-]?key|private[_-]?key|client[_-]?secret|key)[a-z0-9_-]*[\"']?[ 	]*[:=][ 	]*[\"'\`]?[a-zA-Z0-9+/=_-]{20,}"

# shellcheck disable=SC2090
export PSC_NCAT
export PSC_C1_NAME PSC_C1_CI PSC_C1_CS PSC_C1_PROBE PSC_C1_FIX
export PSC_C2_NAME PSC_C2_CI PSC_C2_CS PSC_C2_PROBE PSC_C2_FIX
export PSC_C3_NAME PSC_C3_CI PSC_C3_CS PSC_C3_PROBE PSC_C3_FIX
# shellcheck disable=SC2090
export PSC_C4_NAME PSC_C4_CI PSC_C4_CS PSC_C4_PROBE PSC_C4_FIX
export PSC_C5_NAME PSC_C5_CI PSC_C5_CS PSC_C5_PROBE PSC_C5_FIX
export PSC_C6_NAME PSC_C6_CI PSC_C6_CS PSC_C6_PROBE PSC_C6_FIX
export PSC_C7_NAME PSC_C7_CI PSC_C7_CS PSC_C7_PROBE PSC_C7_FIX
# shellcheck disable=SC2090
export PSC_ENTROPY_CAT PSC_ENTROPY_RE

# ---------------------------------------------------------------------------
# Baseline allow rules: facts that are public for the whole fleet. Repository
# specific exceptions never come here; they go in .public-surface-allow.
# ---------------------------------------------------------------------------
PSC_BASELINE=$(
	cat <<'BASE'
* | * | public organisation identifier and public sibling repository coordinates | github\.com[:/]jim-technologies/(medallion-sdk|medallion-terminal-core|temporaless|invariantprotocol|james|invariantaf|invariantmcp|worker0001)(\.git)?
* | * | public sibling repository names, the published packages of this organisation | (^|[^a-z0-9_])(medallion-sdk|medallion-terminal-core|invariantprotocol|invariantaf|invariantmcp|temporaless|worker0001)($|[^a-z0-9_])
* | * | public brand hostnames | (^|[^a-z0-9_.-])(jimtech\.xyz|medallion\.jimtech\.io)($|[^a-z0-9-])
* | * | RFC 2606 and RFC 6761 reserved example domains and loopback names | (^|[^a-z0-9_.-])(example\.(com|org|net|test|invalid)|acme\.com|localhost)($|[^a-z0-9_.-])
* | * | loopback and unspecified addresses are not private infrastructure | (^|[^0-9.])(127\.0\.0\.1|0\.0\.0\.0)($|[^0-9.])
cluster-shape | * | a language type annotation, not a cluster namespace | ^[ 	]*namespace\??:[ 	]*(str|string|int|float|bool|bytes|any|object|dict|list|set|none|null|undefined|number|boolean|uuid|text|[A-Z][A-Za-z0-9_]*)[ 	]*;?,?[ 	]*$
codename | * | ConnectRPC is a third-party framework, not the first-party codename | (^|[^a-z0-9_])connect(rpc|-go|-web|-es|-query|-node)($|[^a-z0-9_])|@connectrpc/|connectrpc\.com
secret-store | *ignore | an ignore file naming a secret store is what keeps it out of the repository | .*
BASE
)
export PSC_BASELINE

# Text that must never match any category. A pattern that starts flagging one
# of these lines is a regression, and the guard refuses to run until it is
# fixed: a noisy guard gets switched off, and a switched-off guard is how a
# codename lives in public documentation for four months.
PSC_NEUTRAL=$(
	cat <<'NEUTRAL'
the jim-technologies organisation publishes github.com/jim-technologies/medallion-sdk
docs live at https://jimtech.xyz and https://medallion.jimtech.io
see https://example.com https://acme.com http://example.org example.test example.invalid
bind 127.0.0.1 or 0.0.0.0 on localhost for the dev server
return status.Error(codes.Internal, err)
rotate the storage-key and record run id r2-14 for logisticsOps
the ontology of the domain model is documented in the design notes
connect to the terminal and press enter to continue
from google.protobuf.internal import builder as _builder
documentation range 192.0.2.1, public host 172.15.0.1, package version 10.2.3
    namespace: str
node 24.19.0 and go 1.26.4 are the pinned toolchains
NEUTRAL
)
export PSC_NEUTRAL

PSC_ALLOW_FILE="$root/.public-surface-allow"
PSC_DENY_FILE="$root/.public-surface-deny"
PSC_MAX="${PUBLIC_SURFACE_MAX_FINDINGS:-50}"
export PSC_ALLOW_FILE PSC_DENY_FILE PSC_MAX

# ---------------------------------------------------------------------------
# Commit range: what a push would publish, unless told otherwise.
# ---------------------------------------------------------------------------
scan_commits=1
set --
if ! git rev-parse --verify --quiet HEAD >/dev/null 2>&1; then
	scan_commits=0
	range_label='no commits yet'
elif [ "${PUBLIC_SURFACE_FULL_HISTORY:-0}" = "1" ]; then
	set -- --all
	range_label='every commit'
elif [ -n "${PUBLIC_SURFACE_COMMIT_RANGE:-}" ]; then
	set -- "$PUBLIC_SURFACE_COMMIT_RANGE"
	range_label="$PUBLIC_SURFACE_COMMIT_RANGE"
else
	range_label=''
	for ref in origin/main origin/master origin/HEAD; do
		if git rev-parse --verify --quiet "$ref" >/dev/null 2>&1; then
			set -- "$ref..HEAD"
			range_label="$ref..HEAD"
			break
		fi
	done
	if [ -z "$range_label" ]; then
		set -- HEAD
		range_label='HEAD, no upstream branch found'
	fi
fi
PSC_RANGE="$range_label"
export PSC_RANGE

# ---------------------------------------------------------------------------
# The policy engine.
# ---------------------------------------------------------------------------
PSC_AWK=$(
	cat <<'AWKEOF'
function trim(s) { sub(/^[ \t\r]+/, "", s); sub(/[ \t\r]+$/, "", s); return s }

function hexval(c) { return index("0123456789abcdef", tolower(c)) - 1 }

function undecode(s,   out, i, n, c, h1, h2) {
	if (index(s, "%") == 0) return s
	out = ""; n = length(s); i = 1
	while (i <= n) {
		c = substr(s, i, 1)
		if (c == "%" && i + 2 <= n) {
			h1 = hexval(substr(s, i + 1, 1)); h2 = hexval(substr(s, i + 2, 1))
			if (h1 >= 0 && h2 >= 0) { out = out sprintf("%c", h1 * 16 + h2); i += 3; continue }
		}
		out = out c; i++
	}
	return out
}

function globre(g,   out, i, n, c) {
	out = "^"; n = length(g)
	for (i = 1; i <= n; i++) {
		c = substr(g, i, 1)
		if (c == "*") out = out ".*"
		else if (c == "?") out = out "."
		else if (index(".^$+(){}[]|\\", c) > 0) out = out "\\" c
		else out = out c
	}
	return out "$"
}

function die(msg) { fatal = fatal "  " msg "\n" }

function addrule(kind, line, src, lno,   p1, p2, p3, rest, rest2, cat, glob, reason, pat) {
	line = trim(line)
	if (line == "" || substr(line, 1, 1) == "#") return
	p1 = index(line, "|")
	rest = substr(line, p1 + 1)
	p2 = index(rest, "|")
	rest2 = substr(rest, p2 + 1)
	p3 = index(rest2, "|")
	if (p1 == 0 || p2 == 0 || p3 == 0) {
		die(src ":" lno ": expected four fields: category | path-glob | reason | pattern")
		return
	}
	cat = trim(substr(line, 1, p1 - 1))
	glob = trim(substr(rest, 1, p2 - 1))
	reason = trim(substr(rest2, 1, p3 - 1))
	pat = trim(substr(rest2, p3 + 1))
	if (pat == "") { die(src ":" lno ": the pattern field is empty"); return }
	if (glob == "") { die(src ":" lno ": the path-glob field is empty, use * for everywhere"); return }
	if (length(reason) < 8) { die(src ":" lno ": every rule needs a reason of at least 8 characters in field 3"); return }
	if (kind == "allow") {
		if (cat != "*" && !(cat in known)) { die(src ":" lno ": unknown deny category: " cat); return }
		nallow++
		a_cat[nallow] = cat
		a_glob[nallow] = globre(glob)
		a_star[nallow] = (glob == "*")
		a_reason[nallow] = reason
		a_re[nallow] = undecode(pat)
		a_src[nallow] = src ":" lno
	} else {
		nc++
		ndeny++
		cname[nc] = cat
		cci[nc] = undecode(pat)
		ccs[nc] = ""
		cglob[nc] = globre(glob)
		cprobe[nc] = ""
		cfix[nc] = "repository deny rule (" src ":" lno "): " reason
		known[cat] = 1
	}
}

function readrules(path, kind,   line, lno) {
	if (path == "") return
	lno = 0
	while ((getline line < path) > 0) { lno++; addrule(kind, line, path, lno) }
	close(path)
}

function firstmatch(s, re) {
	if (re == "" || s == "") return ""
	if (match(s, re)) return substr(s, RSTART, RLENGTH)
	return ""
}

# Which allow rules can apply is a property of the path, and files arrive in
# path order, so it is decided once per path rather than once per line.
function setpath(p,   k) {
	if (p == curpath) return
	curpath = p
	for (k = 1; k <= nallow; k++) rule_ok[k] = (p ~ a_glob[k])
}

function maskstar(s,   k, out) {
	out = s
	for (k = 1; k <= nallow; k++) if (a_star[k] && a_cat[k] == "*") gsub(a_re[k], "~", out)
	return out
}

function maskcat(s, cat,   k, out) {
	out = s
	for (k = 1; k <= nallow; k++) {
		if (a_cat[k] == "*") { if (a_star[k]) continue } else if (a_cat[k] != cat) continue
		if (!rule_ok[k]) continue
		gsub(a_re[k], "~", out)
	}
	return out
}

function entropy(s,   i, n, c, freq, h, p) {
	n = length(s)
	if (n == 0) return 0
	for (i = 1; i <= n; i++) { c = substr(s, i, 1); freq[c]++ }
	h = 0
	for (c in freq) { p = freq[c] / n; h -= p * log(p) / log(2) }
	return h
}

function looks_like_secret(v,   lv) {
	if (length(v) < 20) return 0
	if (v !~ /[0-9]/ || v !~ /[A-Za-z]/) return 0
	lv = tolower(v)
	if (lv ~ /^(sha1|sha256|sha512|md5)-/) return 0
	if (lv ~ /(example|changeme|change-me|redacted|placeholder|dummy|sample|your-|xxxx|todo|fake|not-a-|deadbeef|abcdef0123)/) return 0
	if (lv ~ /^[0-9a-f]+$/ && (length(v) == 32 || length(v) == 40 || length(v) == 64 || length(v) == 128)) return 0
	if (lv ~ /^0x[0-9a-f]+$/) return 0
	if (v ~ /^[A-Z0-9_]+$/) return 0
	if (entropy(v) < 3.5) return 0
	return 1
}

function redact(m,   n) {
	if (show) return m
	n = length(m)
	if (n <= 6) return "[redacted, " n " chars]"
	return substr(m, 1, 2) "[...]" substr(m, n - 1, 2) " (" n " chars)"
}

function record(origin, where, cat, m, idx) {
	nf++
	catseen[cat] = idx
	if (nf <= maxout) out[nf] = sprintf("  %-7s %-36s %-17s %s", origin, where, cat, redact(m))
}

# Masking can only remove matches, never create one, so a line that does not
# match a category unmasked cannot match it masked either. Masking therefore
# runs only for the categories that actually hit, which keeps the common case
# (a line that hits nothing) to one regex test per category.
function scan(origin, path, where, txt,   i, m, cand, val, low, masked) {
	low = tolower(txt)
	if (!match(low, prefilter_ci) && !match(txt, union_cs)) return
	setpath(path)
	masked_ready = 0
	for (i = 1; i <= nc; i++) {
		if (cglob[i] != "" && path !~ cglob[i]) continue
		if (cci[i] != "" && match(low, cci[i])) {
			ensure_masked(txt)
			masked = maskcat(starlow, cname[i])
			m = firstmatch(masked, cci[i])
			if (m != "") { record(origin, where, cname[i], m, i); continue }
		}
		if (ccs[i] != "" && match(txt, ccs[i])) {
			ensure_masked(txt)
			masked = maskcat(starorig, cname[i])
			m = firstmatch(masked, ccs[i])
			if (m != "") record(origin, where, cname[i], m, i)
		}
	}
	if (entropy_re != "" && entropy_cat_idx > 0 && match(low, entropy_re)) {
		ensure_masked(txt)
		masked = maskcat(starlow, entropy_cat)
		if (match(masked, entropy_re)) {
			cand = substr(starorig, RSTART, RLENGTH)
			val = cand
			sub(/^[^:=]*[:=][ \t]*/, "", val)
			sub(/^["'`]/, "", val)
			if (looks_like_secret(val)) record(origin, where, entropy_cat, val, entropy_cat_idx)
		}
	}
}

function ensure_masked(txt) {
	if (masked_ready) return
	masked_ready = 1
	starorig = maskstar(txt)
	starlow = maskstar(tolower(starorig))
}

function probematch(txt, i, path,   m) {
	setpath(path)
	m = firstmatch(maskcat(maskstar(tolower(maskstar(txt))), cname[i]), cci[i])
	if (m == "") m = firstmatch(maskcat(maskstar(txt), cname[i]), ccs[i])
	return m
}

function selfcheck(   i, j, n, parts, line) {
	for (i = 1; i <= ncat; i++) {
		if (cprobe[i] == "") continue
		n = split(cprobe[i], parts, SEP)
		for (j = 1; j <= n; j++)
			if (probematch(parts[j], i, "PROBE") == "")
				die("category " cname[i] " no longer matches its own probe: " parts[j])
	}
	n = split(neutral, parts, "\n")
	for (j = 1; j <= n; j++) {
		line = parts[j]
		if (trim(line) == "") continue
		for (i = 1; i <= ncat; i++)
			if (probematch(line, i, "NEUTRAL") != "")
				die("category " cname[i] " matches known-good text: " line)
	}
}

function checkbreadth(   i, j, n, parts) {
	for (i = 1; i <= ncat; i++) {
		if (cprobe[i] == "") continue
		n = split(cprobe[i], parts, SEP)
		for (j = 1; j <= n; j++)
			if (probematch(parts[j], i, "PROBE") == "")
				die("an allow rule is broad enough to disable the whole " cname[i] " category; narrow it")
	}
}

function report_fatal() {
	if (reported) return
	reported = 1
	printf("public-surface-check: cannot run\n\n%s\n", fatal)
	printf("Fix the rule or the guard configuration. The gate stays red until the guard can run.\n")
}

BEGIN {
	SEP = sprintf("%c", 31)
	show = (ENVIRON["PUBLIC_SURFACE_SHOW_MATCH"] == "1")
	maxout = ENVIRON["PSC_MAX"] + 0
	if (maxout <= 0) maxout = 50
	fatal = ""
	reported = 0
	nallow = 0
	ndeny = 0
	ncat = ENVIRON["PSC_NCAT"] + 0
	for (i = 1; i <= ncat; i++) {
		cname[i] = ENVIRON["PSC_C" i "_NAME"]
		cci[i] = ENVIRON["PSC_C" i "_CI"]
		ccs[i] = ENVIRON["PSC_C" i "_CS"]
		cfix[i] = ENVIRON["PSC_C" i "_FIX"]
		cprobe[i] = ENVIRON["PSC_C" i "_PROBE"]
		cglob[i] = ""
		known[cname[i]] = 1
	}
	nc = ncat
	entropy_cat = ENVIRON["PSC_ENTROPY_CAT"]
	entropy_re = ENVIRON["PSC_ENTROPY_RE"]
	entropy_cat_idx = 0
	for (i = 1; i <= ncat; i++) if (cname[i] == entropy_cat) entropy_cat_idx = i
	neutral = ENVIRON["PSC_NEUTRAL"]

	n = split(ENVIRON["PSC_BASELINE"], baseline, "\n")
	for (i = 1; i <= n; i++) addrule("allow", baseline[i], "<baseline>", i)
	if (fatal != "") { report_fatal(); exit 2 }

	selfcheck()
	if (fatal != "") { report_fatal(); exit 2 }

	readrules(ENVIRON["PSC_DENY_FILE"], "deny")
	readrules(ENVIRON["PSC_ALLOW_FILE"], "allow")
	if (fatal != "") { report_fatal(); exit 2 }

	checkbreadth()
	if (fatal != "") { report_fatal(); exit 2 }

	union_ci = ""
	union_cs = ""
	for (i = 1; i <= nc; i++) {
		if (cci[i] != "") union_ci = (union_ci == "" ? cci[i] : union_ci "|" cci[i])
		if (ccs[i] != "") union_cs = (union_cs == "" ? ccs[i] : union_cs "|" ccs[i])
	}
	prefilter_ci = union_ci (entropy_re == "" ? "" : "|" entropy_re)
	if (prefilter_ci == "") prefilter_ci = "\001never"
	if (union_ci == "") union_ci = "\001never"
	if (union_cs == "") union_cs = "\001never"
	nf = 0
	nlines = 0
	npaths = 0
}

{
	p1 = index($0, SEP)
	if (p1 == 0) next
	origin = substr($0, 1, p1 - 1)
	rest = substr($0, p1 + 1)
	p2 = index(rest, SEP)
	if (p2 == 0) next
	loc = substr(rest, 1, p2 - 1)
	rest2 = substr(rest, p2 + 1)
	p3 = index(rest2, SEP)
	if (p3 == 0) next
	lno = substr(rest2, 1, p3 - 1)
	txt = substr(rest2, p3 + 1)
	if (origin == "content") {
		nlines++
		scan("content", loc, loc ":" lno, txt)
	} else if (origin == "path") {
		npaths++
		scan("path", loc, loc, txt)
	} else {
		seencommit[loc] = 1
		scan("commit", "COMMIT", substr(loc, 1, 9) " msg:" lno, txt)
	}
}

END {
	if (fatal != "") { report_fatal(); exit 2 }
	ncommit = 0
	for (s in seencommit) ncommit++
	if (nf == 0) {
		printf("public-surface-check: clean (%d lines, %d paths, %d commit messages in %s, %d rules)\n",
			nlines, npaths, ncommit, ENVIRON["PSC_RANGE"], nallow + ndeny)
		exit 0
	}
	printf("public-surface-check: FAIL - %d finding%s\n\n", nf, (nf == 1 ? "" : "s"))
	printf("  %-7s %-36s %-17s %s\n", "where", "location", "category", "match")
	for (i = 1; i <= nf && i <= maxout; i++) print out[i]
	if (nf > maxout) printf("  ... and %d more finding(s)\n", nf - maxout)
	printf("\nwhat to do\n")
	for (cat in catseen) printf("  %s\n      %s\n", cat, cfix[catseen[cat]])
	printf("\n  A commit finding means the message itself must be rewritten before the branch\n")
	printf("  is pushed; changing the file content is not enough.\n")
	printf("  A justified exception is one line in .public-surface-allow:\n")
	printf("      category | path-glob | reason | pattern\n")
	if (!show)
		printf("  Matches are redacted so a public log does not republish them; run\n      PUBLIC_SURFACE_SHOW_MATCH=1 scripts/public-surface-check\n  locally to see them in full.\n")
	exit 1
}
AWKEOF
)

emit_records() {
	# tracked file content, working tree, binary files skipped by git itself
	git grep -z -I -n -E -e '.' -- . 2>/dev/null |
		tr '\000' '\037' |
		awk 'BEGIN { s = sprintf("%c", 31) } { print "content" s $0 }'

	# tracked paths
	git ls-files -z |
		tr '\000' '\n' |
		awk 'BEGIN { s = sprintf("%c", 31) } NF { print "path" s $0 s "0" s $0 }'

	# the commit messages a push would publish
	if [ "$scan_commits" = "1" ]; then
		git log --format="%x02%H%n%B" "$@" 2>/dev/null |
			awk 'BEGIN { s = sprintf("%c", 31); m = sprintf("%c", 2) }
				substr($0, 1, 1) == m { sha = substr($0, 2); n = 0; next }
				{ n++; if ($0 != "") print "commit" s sha s n s $0 }'
	fi
}

status=0
emit_records "$@" | awk "$PSC_AWK" || status=$?

case "$status" in
0) ;;
1) printf 'public-surface-check: the public surface is not clean\n' >&2 ;;
*) printf 'public-surface-check: the guard could not run\n' >&2 ;;
esac
exit "$status"
